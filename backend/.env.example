# MediCore Production Backend Environment Template (Phases 2-9)
# IMPORTANT: Never commit real secrets to version control.
# Never expose GEMINI_API_KEY, DATABASE_URL, or gateway secrets to Android clients.

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database with Connection Pooling
DATABASE_URL=postgresql://medicore_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/medicore_db?schema=public&connection_limit=20&pool_timeout=15

# JWT & Cryptography Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=CHANGE_ME_PRODUCTION_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH_SECRET_MIN_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# CORS & Security
CORS_ORIGIN=https://app.medicore-health.in,https://admin.medicore-health.in
ENFORCE_HTTPS=true

# Phase 7: Backend-Only AI Configuration (Google Gemini)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# Phase 6 & Phase 9: Payment Gateway Configuration (Razorpay)
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_patient_billing_webhook_secret
RAZORPAY_SAAS_WEBHOOK_SECRET=whsec_saas_subscription_webhook_secret

# Phase 8: Firebase Cloud Messaging & Notification Queue
FCM_PROJECT_ID=medicore-production-fcm
FCM_SERVICE_ACCOUNT_PATH=/secrets/fcm-service-account.json
REDIS_URL=redis://localhost:6379/0

# Phase 8: Configurable Email & SMS Providers
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=notifications@medicore-health.in
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

SMS_PROVIDER=MSG91_COMPATIBLE
SMS_API_KEY=CHANGE_ME_SMS_API_KEY
SMS_SENDER_ID=MDICOR

# Phase 8: Observability & Error Tracking
SENTRY_DSN=
PROMETHEUS_METRICS_TOKEN=CHANGE_ME_METRICS_SCRAPE_TOKEN
PRIVATE_STORAGE_BUCKET=medicore-private-clinical-and-kyc-docs
