enum LabOrderStatus {
  REQUESTED
  COLLECTED
  PROCESSING
  COMPLETED
  VERIFIED
  CANCELLED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum AdmissionStatus {
  REQUESTED
  APPROVED
  ADMITTED
  DISCHARGE_APPROVED
  DISCHARGED
  CANCELLED
}

model LabTestCatalogue {
  id                String   @id @default(uuid()) @db.Uuid
  hospitalId        String   @map("hospital_id") @db.Uuid
  code              String
  name              String
  category          String // HEMATOLOGY, BIOCHEMISTRY, MICROBIOLOGY, PATHOLOGY
