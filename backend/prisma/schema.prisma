  userId        String   @map("user_id") @db.Uuid
  userRole      String   @map("user_role")
  action        String // AI_CHAT_QUERY, AI_REPORT_SUMMARIZED, AI_CLINICAL_DRAFT_CREATED, AI_CLINICAL_DRAFT_APPROVED, AI_PROMPT_INJECTION_BLOCKED, AI_CONSENT_UPDATED
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  securityFlags String?  @map("security_flags")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_audit_logs")
}

// ============================================================================
// PHASE 8: Security, Device Sessions, Notifications, Outbox & Messaging
// ============================================================================

model UserMfaConfig {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  isEnabled       Boolean   @default(false) @map("is_enabled")
  method          String    @default("TOTP") // TOTP, SMS_OTP, EMAIL_OTP
  secretEncrypted String?   @map("secret_encrypted")
  backupCodesHash String[]  @default([]) @map("backup_codes_hash")
  verifiedAt      DateTime? @map("verified_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("user_mfa_configs")
}

model RegisteredDevice {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceName    String    @map("device_name")
  platform      String    @default("ANDROID") // ANDROID, WEB, IOS
  deviceModel   String?   @map("device_model")
  appVersion    String    @default("1.0.0") @map("app_version")
  fcmToken      String?   @map("fcm_token")
  fcmTokenValid Boolean   @default(true) @map("fcm_token_valid")
  ipAddress     String?   @map("ip_address")
  sessionStatus String    @default("ACTIVE") @map("session_status") // ACTIVE, REVOKED, EXPIRED
  isSuspicious  Boolean   @default(false) @map("is_suspicious")
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, sessionStatus])
  @@map("registered_devices")
}

model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  pushEnabled          Boolean  @default(true) @map("push_enabled")
  emailEnabled         Boolean  @default(true) @map("email_enabled")
  smsEnabled           Boolean  @default(true) @map("sms_enabled")
  appointmentAlerts    Boolean  @default(true) @map("appointment_alerts")
  clinicalAlerts       Boolean  @default(true) @map("clinical_alerts")
  financialAlerts      Boolean  @default(true) @map("financial_alerts")
  operationsAlerts     Boolean  @default(true) @map("operations_alerts")
  redactLockScreenText Boolean  @default(true) @map("redact_lock_screen_text")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationOutbox {
  id                String    @id @default(uuid()) @db.Uuid
  idempotencyKey    String    @unique @map("idempotency_key")
  hospitalId        String?   @map("hospital_id") @db.Uuid
  recipientUserId   String    @map("recipient_user_id") @db.Uuid
  category          String // APPOINTMENT, CLINICAL, FINANCIAL, OPERATIONS, SYSTEM
  eventType         String    @map("event_type")
  publicTitle       String    @map("public_title") // Safe for lock-screen (no PHI)
  publicBody        String    @map("public_body") // Safe for lock-screen (no PHI)
  authenticatedBody String    @map("authenticated_body") // Full details inside authenticated app
  deepLinkRoute     String?   @map("deep_link_route")
  channel           String    @default("FCM") // FCM, EMAIL, SMS
  status            String    @default("QUEUED") // QUEUED, PROCESSING, DELIVERED, FAILED, DEAD_LETTER, READ
  retryCount        Int       @default(0) @map("retry_count")
  maxRetries        Int       @default(3) @map("max_retries")
  lastError         String?   @map("last_error")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([recipientUserId, createdAt])
  @@index([status, retryCount])
  @@map("notification_outbox")
}

model MessagingDeliveryLog {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String?  @map("hospital_id") @db.Uuid
  recipient     String // Masked email or phone
  channel       String // EMAIL, SMS, OTP
  providerName  String   @map("provider_name") // CONFIGURABLE_SMTP, CONFIGURABLE_SMS_GATEWAY
  templateCode  String   @map("template_code")
  status        String   @default("SENT") // QUEUED, SENT, DELIVERED, FAILED
  retryCount    Int      @default(0) @map("retry_count")
  externalMsgId String?  @map("external_msg_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([channel, status, createdAt])
  @@map("messaging_delivery_logs")
}

// ============================================================================
// PHASE 9: SaaS Product Launch & Business Operations Models
// Strictly separated from Phase 6 patient hospital billing.
// ============================================================================

enum OnboardingStatus {
  REGISTERED
  DOCUMENTS_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVATED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

model SubscriptionPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  planCode            String   @unique @map("plan_code") // STARTER, PROFESSIONAL, ENTERPRISE
  name                String
  description         String
  monthlyPricePaise   Int      @map("monthly_price_paise")
  annualPricePaise    Int      @map("annual_price_paise")
  trialDays           Int      @default(14) @map("trial_days")
  maxStaffAccounts    Int      @map("max_staff_accounts")
  maxBranches         Int      @map("max_branches")
  monthlyAiTokenLimit Int      @map("monthly_ai_token_limit")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions HospitalSubscription[]

  @@map("subscription_plans")
}

model PlanFeature {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @map("plan_id") @db.Uuid
  featureCode String  @map("feature_code") // MODULE_LAB, MODULE_PHARMACY, MODULE_IPD, ADVANCED_ANALYTICS, CUSTOM_INTEGRATIONS, AI_COPILOT
  featureName String  @map("feature_name")
  isEnabled   Boolean @default(true) @map("is_enabled")
  limitValue  Int?    @map("limit_value")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@map("plan_features")
}

model HospitalSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  hospitalId         String             @unique @map("hospital_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  planCode           String             @map("plan_code")
  billingCycle       String             @default("MONTHLY") @map("billing_cycle") // MONTHLY, ANNUAL
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  gracePeriodEndsAt  DateTime?          @map("grace_period_ends_at")
  autoRenew          Boolean            @default(true) @map("auto_renew")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]
  payments SubscriptionPayment[]
  events   SubscriptionEvent[]

  @@index([status, currentPeriodEnd])
  @@map("hospital_subscriptions")
}

model SubscriptionInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceNumber  String    @unique @map("invoice_number")
  hospitalId     String    @map("hospital_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  planCode       String    @map("plan_code")
  billingCycle   String    @map("billing_cycle")
  subtotalPaise  Int       @map("subtotal_paise")
  taxPaise       Int       @map("tax_paise")
  totalPaise     Int       @map("total_paise")
  status         String    @default("ISSUED") // ISSUED, PAID, FAILED, REFUNDED, VOID
  periodStart    String    @map("period_start")
  periodEnd      String    @map("period_end")
  dueDate        String    @map("due_date")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription HospitalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id               String   @id @default(uuid()) @db.Uuid
  receiptNumber    String   @unique @map("receipt_number")
  hospitalId       String   @map("hospital_id") @db.Uuid
  subscriptionId   String   @map("subscription_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  amountPaise      Int      @map("amount_paise")
  paymentMethod    String   @map("payment_method") // UPI, CARD, NET_BANKING
  gatewayProvider  String   @default("RAZORPAY") @map("gateway_provider")
  gatewayOrderId   String   @map("gateway_order_id")
  gatewayPaymentId String?  @unique @map("gateway_payment_id")
  gatewaySignature String?  @map("gateway_signature")
  idempotencyKey   String   @unique @map("idempotency_key")
  status           String   @default("CAPTURED") // PENDING, CAPTURED, FAILED, REFUNDED
  failureReason    String?  @map("failure_reason")
  refundedPaise    Int      @default(0) @map("refunded_paise")
  createdAt        DateTime @default(now()) @map("created_at")

  subscription HospitalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@map("subscription_payments")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  eventType      String   @map("event_type") // TRIAL_STARTED, PLAN_UPGRADED, PLAN_DOWNGRADED, PAYMENT_CAPTURED, PAYMENT_FAILED, GRACE_PERIOD_ENTERED, SUSPENDED, CANCELLED, REACTIVATED
  fromPlanCode   String?  @map("from_plan_code")
  toPlanCode     String?  @map("to_plan_code")
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  subscription HospitalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([hospitalId, createdAt])
  @@map("subscription_events")
}

model HospitalBranch {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @map("hospital_id") @db.Uuid
  branchName   String   @map("branch_name")
  branchCode   String   @map("branch_code")
  address      String
  city         String
  state        String
  contactPhone String   @map("contact_phone")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([hospitalId, branchCode])
  @@index([hospitalId])
  @@map("hospital_branches")
}

model HospitalOnboarding {
  id                    String           @id @default(uuid()) @db.Uuid
  hospitalId            String           @unique @map("hospital_id") @db.Uuid
  legalName             String           @map("legal_name")
  displayName           String           @map("display_name")
  hospitalType          String           @map("hospital_type") // MULTI_SPECIALTY, SINGLE_SPECIALTY, DIAGNOSTIC_CENTER, CLINIC
  registrationNumber    String           @unique @map("registration_number")
  clinicalLicenseNumber String           @unique @map("clinical_license_number")
  gstin                 String?
  address               String
  city                  String
  state                 String
  pincode               String
  adminFullName         String           @map("admin_full_name")
  adminEmail            String           @map("admin_email")
  adminPhone            String           @map("admin_phone")
  status                OnboardingStatus @default(REGISTERED)
  rejectionReason       String?          @map("rejection_reason")
  reviewedByUserId      String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt            DateTime?        @map("reviewed_at")
  activatedAt           DateTime?        @map("activated_at")
  submissionCount       Int              @default(1) @map("submission_count")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  documents HospitalDocument[]

  @@index([status])
  @@map("hospital_onboardings")
}

model HospitalDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  onboardingId       String   @map("onboarding_id") @db.Uuid
  hospitalId         String   @map("hospital_id") @db.Uuid
  documentType       String   @map("document_type") // CLINICAL_ESTABLISHMENT_LICENSE, NABH_CERTIFICATE, GST_CERTIFICATE, PAN_CARD
  fileName           String   @map("file_name")
  mimeType           String   @map("mime_type")
  fileSizeBytes      Int      @map("file_size_bytes")
  privateStorageKey  String   @unique @map("private_storage_key")
  verificationStatus String   @default("PENDING") @map("verification_status") // PENDING, VERIFIED, REJECTED
  uploadedByUserId   String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt         DateTime @default(now()) @map("uploaded_at")

  onboarding HospitalOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("hospital_documents")
}

model SupportTicket {
  id               String              @id @default(uuid()) @db.Uuid
  ticketNumber     String              @unique @map("ticket_number")
  hospitalId       String              @map("hospital_id") @db.Uuid
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  assignedToUserId String?             @map("assigned_to_user_id") @db.Uuid
  category         String // BILLING_SUBSCRIPTION, TECHNICAL_ISSUE, ONBOARDING_VERIFICATION, FEATURE_REQUEST, SECURITY_COMPLIANCE
  priority         String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  subject          String
  description      String
  status           SupportTicketStatus @default(OPEN)
  resolvedAt       DateTime?           @map("resolved_at")
  closedAt         DateTime?           @map("closed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  messages    SupportMessage[]
  attachments SupportAttachment[]

  @@index([hospitalId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  hospitalId   String   @map("hospital_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  senderRole   String   @map("sender_role")
  senderName   String   @map("sender_name")
  messageBody  String   @map("message_body")
  isStaffReply Boolean  @default(false) @map("is_staff_reply")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  hospitalId       String   @map("hospital_id") @db.Uuid
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  storageKey       String   @unique @map("storage_key")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_attachments")
}

model FeatureEntitlement {
  id             String   @id @default(uuid()) @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  featureCode    String   @map("feature_code")
  isEntitled     Boolean  @map("is_entitled")
  limitValue     Int?     @map("limit_value")
  currentUsage   Int      @default(0) @map("current_usage")
  sourcePlanCode String   @map("source_plan_code")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([hospitalId, featureCode])
  @@map("feature_entitlements")
}

model UsageMetric {
  id           String   @id @default(uuid()) @db.Uuid
  hospitalId   String   @map("hospital_id") @db.Uuid
  metricCode   String   @map("metric_code") // ACTIVE_STAFF, ACTIVE_BRANCHES, MONTHLY_AI_TOKENS, MONTHLY_APPOINTMENTS, STORAGE_MB
  periodMonth  String   @map("period_month") // YYYY-MM
  currentCount Int      @default(0) @map("current_count")
  planLimit    Int      @map("plan_limit")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([hospitalId, metricCode, periodMonth])
  @@index([hospitalId, periodMonth])
  @@map("usage_metrics")
}

model PlatformAnnouncement {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  message        String
  severity       String    @default("INFO") // INFO, MAINTENANCE, CRITICAL
  targetAudience String    @default("ALL_HOSPITALS") // ALL_HOSPITALS, HOSPITAL_ADMINS, DOCTORS
  isActive       Boolean   @default(true) @map("is_active")
  publishedById  String    @map("published_by_id") @db.Uuid
  publishedAt    DateTime  @default(now()) @map("published_at")
  expiresAt      DateTime? @map("expires_at")

  @@index([isActive, publishedAt])
  @@map("platform_announcements")
}
