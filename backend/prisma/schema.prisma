generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleCode {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  PATIENT
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  OPD
  WALK_IN
  FOLLOW_UP
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String   @map("full_name")
  email            String   @unique
  phone            String?  @unique
  passwordHash     String   @map("password_hash")
  isEmailVerified  Boolean  @default(false) @map("is_email_verified")
  isActive         Boolean  @default(true) @map("is_active")
  activeHospitalId String?  @map("active_hospital_id") @db.Uuid
  fcmToken         String?  @map("fcm_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships        HospitalMembership[]
  userRoles          UserRoleAssignment[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  sentInvitations    HospitalInvitation[] @relation("InvitedByUser")
  auditLogs          AuditLog[]
  patientProfile     Patient?
  doctorProfile      Doctor?

  @@index([email])
  @@index([phone])
  @@map("users")
}

enum DirectoryVerificationStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

model Hospital {
  id                 String                      @id @default(uuid()) @db.Uuid
  directoryCode      String?                     @unique @map("directory_code")
  name               String
  legalName          String?                     @map("legal_name")
  displayName        String?                     @map("display_name")
  registrationNumber String                      @unique @map("registration_number")
  category           String
  facilityType       String?                     @map("facility_type")
  ownershipType      String?                     @map("ownership_type")
  logoUrl            String?                     @map("logo_url")
  address            String
  city               String
  state              String
  pincode            String?
  contactEmail       String?                     @map("contact_email")
  contactPhone       String?                     @map("contact_phone")
  primaryPhone       String?                     @map("primary_phone")
  secondaryPhone     String?                     @map("secondary_phone")
  email              String?
  website            String?
  emergencyAvailable Boolean?                    @map("emergency_available")
  verificationStatus DirectoryVerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  sourceName         String?                     @map("source_name")
  sourceUrl          String?                     @map("source_url")
  lastVerifiedAt     DateTime?                   @map("last_verified_at")
  isActiveTenant     Boolean                     @default(false) @map("is_active_tenant")
  timezone           String                      @default("Asia/Kolkata")
  totalBeds          Int                         @default(0) @map("total_beds")
  availableBeds      Int                         @default(0) @map("available_beds")
  status             HospitalStatus              @default(PENDING)
  departments        String[]                    @default([])
  createdByUserId    String?                     @map("created_by_user_id") @db.Uuid
  approvedByUserId   String?                     @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?                   @map("approved_at")
  rejectionReason    String?                     @map("rejection_reason")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")

  memberships         HospitalMembership[]
  userRoles           UserRoleAssignment[]
  invitations         HospitalInvitation[]
  auditLogs           AuditLog[]
  patientLinks        PatientHospitalLink[]
  hospitalDepartments Department[]
  doctorAssignments   DoctorHospitalAssignment[]
  doctorAvailability  DoctorAvailability[]
  doctorBlockedTimes  DoctorBlockedTime[]
  appointments        Appointment[]
  contacts            HospitalContact[]
  specialties         HospitalSpecialty[]
  sources             HospitalSource[]

  @@index([status])
  @@index([verificationStatus])
  @@index([city, pincode])
  @@index([facilityType, ownershipType])
  @@map("hospitals")
}

model HospitalContact {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @map("hospital_id") @db.Uuid
  contactType  String    @map("contact_type") // PRIMARY_PHONE, SECONDARY_PHONE, EMAIL, WEBSITE
  contactValue String    @map("contact_value")
  isVerified   Boolean   @default(false) @map("is_verified")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("hospital_contacts")
}

model HospitalSpecialty {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @map("hospital_id") @db.Uuid
  specialtyName String   @map("specialty_name")
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, specialtyName])
  @@index([specialtyName])
  @@map("hospital_specialties")
}

model HospitalSource {
  id             String   @id @default(uuid()) @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  sourceName     String   @map("source_name")
  sourceUrl      String   @map("source_url")
  dataStatusNote String?  @map("data_status_note")
  rawPayloadJson Json?    @map("raw_payload_json")
  importedAt     DateTime @default(now()) @map("imported_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("hospital_sources")
}

model HospitalMembership {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  hospitalId   String           @map("hospital_id") @db.Uuid
  department   String?
  employeeCode String?          @map("employee_code")
  status       MembershipStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now()) @map("joined_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital  Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userRoles UserRoleAssignment[]

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([userId])
  @@map("hospital_memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]
  invitations     HospitalInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  hospitalId   String?  @map("hospital_id") @db.Uuid
  membershipId String?  @map("membership_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital   Hospital?           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  membership HospitalMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, hospitalId])
  @@index([userId, hospitalId])
  @@map("user_roles")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  deviceInfo        String?   @map("device_info")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  code       String
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  otpCode   String    @map("otp_code")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model HospitalInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @map("hospital_id") @db.Uuid
  email           String
  roleId          String           @map("role_id") @db.Uuid
  department      String?
  tokenHash       String           @unique @map("token_hash")
  inviteCode      String           @unique @map("invite_code")
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@index([email])
  @@map("hospital_invitations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  hospitalId String?  @map("hospital_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================================
// PHASE 3: Patient, Doctor, Department & Appointment Management Models
// ============================================================================

model Patient {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  globalPatientId       String   @unique @map("global_patient_id")
  dateOfBirth           String   @map("date_of_birth")
  gender                String
  bloodGroup            String   @map("blood_group")
  emergencyContactName  String   @map("emergency_contact_name")
  emergencyContactPhone String   @map("emergency_contact_phone")
  address               String
  city                  String
  state                 String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalLinks PatientHospitalLink[]
  appointments  Appointment[]

  @@index([globalPatientId])
  @@map("patients")
}

model PatientHospitalLink {
  id                         String   @id @default(uuid()) @db.Uuid
  patientId                  String   @map("patient_id") @db.Uuid
  hospitalId                 String   @map("hospital_id") @db.Uuid
  hospitalRegistrationNumber String   @map("hospital_registration_number")
  registeredByUserId         String?  @map("registered_by_user_id") @db.Uuid
  status                     String   @default("ACTIVE")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([patientId, hospitalId])
  @@unique([hospitalId, hospitalRegistrationNumber])
  @@index([hospitalId])
  @@map("patient_hospital_links")
}

model Department {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @map("hospital_id") @db.Uuid
  name          String
  code          String
  description   String
  floorLocation String?  @map("floor_location")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hospital          Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorAssignments DoctorHospitalAssignment[]
  appointments      Appointment[]

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
  @@map("departments")
}

model Doctor {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  medicalLicenseNumber String   @unique @map("medical_license_number")
  qualification        String
  specialization       String
  experienceYears      Int      @default(5) @map("experience_years")
  bio                  String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalAssignments DoctorHospitalAssignment[]
  availabilities      DoctorAvailability[]
  blockedTimes        DoctorBlockedTime[]
  appointments        Appointment[]

  @@index([specialization])
  @@map("doctors")
}

model DoctorHospitalAssignment {
  id                  String                   @id @default(uuid()) @db.Uuid
  doctorId            String                   @map("doctor_id") @db.Uuid
  hospitalId          String                   @map("hospital_id") @db.Uuid
  departmentId        String                   @map("department_id") @db.Uuid
  consultationFee     Int                      @default(500) @map("consultation_fee")
  slotDurationMinutes Int                      @default(30) @map("slot_duration_minutes")
  verificationStatus  DoctorVerificationStatus @default(PENDING) @map("verification_status")
  verifiedByUserId    String?                  @map("verified_by_user_id") @db.Uuid
  verifiedAt          DateTime?                @map("verified_at")
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId])
  @@index([hospitalId, departmentId, verificationStatus])
  @@map("doctor_hospital_assignments")
}

model DoctorAvailability {
  id                  String   @id @default(uuid()) @db.Uuid
  doctorId            String   @map("doctor_id") @db.Uuid
  hospitalId          String   @map("hospital_id") @db.Uuid
  dayOfWeek           Int      @map("day_of_week") // 0 = Sunday .. 6 = Saturday
  startTime           String   @map("start_time") // "09:00"
  endTime             String   @map("end_time") // "17:00"
  slotDurationMinutes Int      @default(30) @map("slot_duration_minutes")
  timezone            String   @default("Asia/Kolkata")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId, dayOfWeek])
  @@index([hospitalId, doctorId])
  @@map("doctor_availability")
}

model DoctorBlockedTime {
  id             String   @id @default(uuid()) @db.Uuid
  doctorId       String   @map("doctor_id") @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  blockedDate    String   @map("blocked_date") // "YYYY-MM-DD"
  startTime      String?  @map("start_time") // null if full-day leave
  endTime        String?  @map("end_time")
  isFullDayLeave Boolean  @default(false) @map("is_full_day_leave")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([doctorId, hospitalId, blockedDate])
  @@map("doctor_blocked_times")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  appointmentNumber  String            @unique @map("appointment_number")
  hospitalId         String            @map("hospital_id") @db.Uuid
  departmentId       String            @map("department_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  appointmentDate    String            @map("appointment_date") // "YYYY-MM-DD"
  slotStartTime      String            @map("slot_start_time") // "10:00"
  slotEndTime        String            @map("slot_end_time") // "10:30"
  timezone           String            @default("Asia/Kolkata")
  type               AppointmentType   @default(OPD)
  status             AppointmentStatus @default(PENDING)
  reasonForVisit     String            @map("reason_for_visit")
  cancellationReason String?           @map("cancellation_reason")
  clinicalNotes      String?           @map("clinical_notes")
  bookedByUserId     String            @map("booked_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  hospital      Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department    Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  doctor        Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  statusHistory AppointmentStatusHistory[]

  @@index([hospitalId, appointmentDate, status])
  @@index([doctorId, appointmentDate, slotStartTime])
  @@index([patientId, appointmentDate])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id              String             @id @default(uuid()) @db.Uuid
  appointmentId   String             @map("appointment_id") @db.Uuid
  fromStatus      AppointmentStatus? @map("from_status")
  toStatus        AppointmentStatus  @map("to_status")
  changedByUserId String             @map("changed_by_user_id") @db.Uuid
  changedByRole   String             @map("changed_by_role")
  notes           String?
  changedAt       DateTime           @default(now()) @map("changed_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, changedAt])
  @@map("appointment_status_history")
}

// ============================================================================
// PHASE 4: Electronic Health Records (EHR) & Clinical Management Models
// ============================================================================

enum EncounterStatus {
  DRAFT
  IN_PROGRESS
  FINALIZED
  AMENDED
}

enum DiagnosisClassification {
  PRIMARY
  SECONDARY
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  DISPENSED
  CANCELLED
}

model PatientAllergy {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  hospitalId   String   @map("hospital_id") @db.Uuid
  allergen     String
  reaction     String
  severity     String // MILD, MODERATE, SEVERE
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([patientId, hospitalId])
  @@map("patient_allergies")
}

model PatientCondition {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  hospitalId     String   @map("hospital_id") @db.Uuid
  conditionName  String   @map("condition_name")
  icd10Code      String?  @map("icd10_code")
  clinicalStatus String   @default("ACTIVE") @map("clinical_status")
  onsetDate      String?  @map("onset_date")
  recordedById   String   @map("recorded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([patientId, hospitalId])
  @@map("patient_conditions")
}

model PatientMedicalHistory {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  hospitalId   String   @map("hospital_id") @db.Uuid
  category     String // SURGICAL, FAMILY, SOCIAL, IMMUNIZATION, PAST_ILLNESS
  title        String
  details      String
  recordedDate String   @map("recorded_date")
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([patientId, hospitalId])
  @@map("patient_medical_history")
}

model Encounter {
  id            String          @id @default(uuid()) @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  hospitalId    String          @map("hospital_id") @db.Uuid
  doctorId      String          @map("doctor_id") @db.Uuid
  appointmentId String?         @map("appointment_id") @db.Uuid
  encounterType String          @default("OPD") @map("encounter_type") // OPD, WALK_IN, IPD, EMERGENCY
  status        EncounterStatus @default(DRAFT)
  version       Int             @default(1)
  finalizedAt   DateTime?       @map("finalized_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  notes          EncounterNote[]
  diagnoses      Diagnosis[]
  vitals         PatientVital[]
  treatmentPlans TreatmentPlan[]
  prescriptions  Prescription[]
  documents      ClinicalDocument[]
  followUps      FollowUpRecommendation[]
  recordVersions ClinicalRecordVersion[]

  @@index([hospitalId, patientId, createdAt])
  @@index([doctorId, status])
  @@map("encounters")
}

model EncounterNote {
  id                  String   @id @default(uuid()) @db.Uuid
  encounterId         String   @map("encounter_id") @db.Uuid
  hospitalId          String   @map("hospital_id") @db.Uuid
  authorUserId        String   @map("author_user_id") @db.Uuid
  symptoms            String
  examinationFindings String   @map("examination_findings")
  assessment          String
  nursingObservations String?  @map("nursing_observations")
  isAmendment         Boolean  @default(false) @map("is_amendment")
  amendmentReason     String?  @map("amendment_reason")
  versionNumber       Int      @default(1) @map("version_number")
