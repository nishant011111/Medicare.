  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([hospitalId, sampleTrackingId])
  @@map("lab_samples")
}

model LabResult {
  id                String    @id @default(uuid()) @db.Uuid
  labOrderItemId    String    @unique @map("lab_order_item_id") @db.Uuid
  hospitalId        String    @map("hospital_id") @db.Uuid
