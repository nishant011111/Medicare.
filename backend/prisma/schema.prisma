}

model Discharge {
  id                 String   @id @default(uuid()) @db.Uuid
  hospitalId         String   @map("hospital_id") @db.Uuid
  admissionId        String   @unique @map("admission_id") @db.Uuid
  patientId          String   @map("patient_id") @db.Uuid
  approvedByDoctorId String   @map("approved_by_doctor_id") @db.Uuid
  dischargeCondition String   @map("discharge_condition") // STABLE, IMPROVED, REFERRED
