// ============================================================================
// PHASE 6: Billing, Payments, Insurance/TPA, Expenses & Financial Analytics
// All monetary fields are stored as exact integer minor units (Paise: 1 INR = 100 Paise)
// Never use floating-point arithmetic for money.
// ============================================================================

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethodType {
  CASH
  UPI
  CARD
  NET_BANKING
  BANK_TRANSFER
  INSURANCE_SETTLEMENT
}

enum PaymentRecordStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ClaimStatus {
