{
  "info": {
    "name": "MediCore Phase 2 - Multi-Hospital API Collection",
    "_postman_id": "a72f92c1-889b-42d1-9122-984122719200",
    "description": "Complete Postman collection for MediCore Phase 2 Authentication, Multi-Hospital Management, Memberships, and Super Admin APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "hospitalId",
      "value": "11111111-1111-4111-8111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Siddharth Roy\",\n  \"email\": \"siddharth.roy@medicore.org\",\n  \"phone\": \"+919123456780\",\n  \"password\": \"StrongPassword#2026\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"superadmin@medicore.org\",\n  \"password\": \"MediCore@2026\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"rahul.verma@citycare.org\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"rahul.verma@citycare.org\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"NewPassword@2026\"\n}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/verify-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"siddharth.roy@medicore.org\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Hospitals",
      "item": [
        {
          "name": "List Hospitals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/hospitals?page=1&limit=20"
          }
        },
        {
          "name": "Register New Hospital",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/hospitals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunrise Children Hospital\",\n  \"registrationNumber\": \"MH-MUM-2026-555\",\n  \"category\": \"Pediatric Specialty\",\n  \"address\": \"Linking Road, Bandra West\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"contactEmail\": \"info@sunrisechildren.org\",\n  \"contactPhone\": \"+91 22 2600 1122\",\n  \"totalBeds\": 180,\n  \"availableBeds\": 45\n}"
            }
          }
        },
        {
          "name": "Get Hospital Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/hospitals/{{hospitalId}}"
          }
        },
        {
          "name": "Update Hospital Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/hospitals/{{hospitalId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availableBeds\": 55,\n  \"logoUrl\": \"https://assets.medicore.org/logos/citycare-v2.png\"\n}"
            }
          }
        },
        {
          "name": "Select Active Hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/hospitals/{{hospitalId}}/select"
          }
        }
      ]
    },
    {
      "name": "Memberships & Invitations",
      "item": [
        {
          "name": "Get Memberships",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/memberships"
          }
        },
        {
          "name": "Invite Staff Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/hospitals/{{hospitalId}}/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.verma@citycare.org\",\n  \"roleCode\": \"DOCTOR\",\n  \"department\": \"Cardiology\"\n}"
            }
          }
        },
        {
          "name": "Accept Invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/invitations/accept",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"INV-123456\"\n}"
            }
          }
        },
        {
          "name": "Update Membership Status / Roles",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/memberships/MEMBERSHIP_UUID",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"roles\": [\"DOCTOR\", \"HOSPITAL_ADMIN\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Super Admin",
      "item": [
        {
          "name": "List All Hospitals & Platform Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/hospitals"
          }
        },
        {
          "name": "Approve Hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/hospitals/44444444-4444-4444-8444-444444444444/approve"
          }
        },
        {
          "name": "Reject Hospital",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/hospitals/44444444-4444-4444-8444-444444444444/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Incomplete state medical board license number\"\n}"
            }
          }
        },
        {
          "name": "Suspend Hospital",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/hospitals/11111111-1111-4111-8111-111111111111/suspend",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Scheduled compliance audit\"\n}"
            }
          }
        }
      ]
    }
  ]
}
